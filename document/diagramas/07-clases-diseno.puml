@startuml clases-diseno
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
title Diagrama de clases de diseño - controladores, servicios y persistencia
left to right direction

package "presentation.controller" {
  class LoginController {
    + ingresar() : void
  }
  class InscripcionController {
    + buscarAlumno() : void
    + inscribir() : void
  }
  class AsistenciaController {
    + seleccionarClase() : void
    + guardar() : void
  }
  class ActaController {
    + registrarFinal() : void
    + cerrarActa() : void
  }
}

package "security" {
  class Sesion {
    - usuario : Usuario
    + iniciar(u : Usuario) : void
    + usuarioActual() : Usuario
    + cerrar() : void
  }
  class PasswordHasher {
    + hashear(clave : char[]) : String
    + verificar(clave : char[], hash : String) : boolean
  }
  class Autorizador {
    + exigirRol(roles : Rol...) : void
    + exigirDocenteAsignado(comisionId : long) : void
  }
}

package "service" {
  class AuthService {
    + iniciarSesion(usuario : String, clave : char[]) : Usuario
  }
  class AlumnoService {
    + crear(datos : Alumno) : Alumno
    + buscarPorDni(dni : String) : Alumno
    + modificar(datos : Alumno) : Alumno
    + darDeBaja(id : long) : void
  }
  class InscripcionService {
    + inscribir(alumnoId : long, comisionId : long) : Inscripcion
  }
  class AsistenciaService {
    + registrar(claseId : long, marcas : Map<Long, EstadoAsistencia>) : void
    + justificar(asistenciaId : long, motivo : String, certificado : String) : void
    + cerrar(comisionId : long) : void
  }
  class CalificacionService {
    + registrar(inscripcionId : long, evaluacionId : long, nota : BigDecimal) : Calificacion
    + modificar(calificacionId : long, nota : BigDecimal) : Calificacion
    + registrarFinal(actaId : long, inscripcionId : long, nota : BigDecimal) : Calificacion
  }
  class ActaService {
    + cerrar(actaId : long) : void
    + reabrir(actaId : long, motivo : String) : void
  }
  class AuditoriaService {
    + registrar(accion : String, entidad : String, id : long, anterior : String, nuevo : String, motivo : String) : void
  }
}

package "domain.rule" {
  class CalculadoraRegularidad {
    + {static} UMBRAL : BigDecimal = 70
    + porcentaje(asistencias : List<Asistencia>) : BigDecimal
    + esRegular(porcentaje : BigDecimal) : boolean
  }
  class CalculadoraCondicion {
    + promedio(notas : List<Calificacion>) : BigDecimal
    + condicionDeCursada(porcentaje : BigDecimal, promedio : BigDecimal) : EstadoAcademico
    + resultadoFinal(nota : BigDecimal) : EstadoAcademico
  }
  class ValidadorCorrelativas {
    + faltantes(alumnoId : long, materiaId : long) : List<Materia>
  }
}

package "repository" {
  interface AlumnoRepository
  interface InscripcionRepository
  interface AsistenciaRepository
  interface CalificacionRepository
  interface ActaRepository
}

package "persistence" {
  class InscripcionRepositoryImpl
  class ConfiguracionBaseDatos {
    + url : String
    + usuario : String
  }
}

LoginController --> AuthService
InscripcionController --> InscripcionService
AsistenciaController --> AsistenciaService
ActaController --> CalificacionService
ActaController --> ActaService
AuthService --> PasswordHasher
AuthService --> Sesion
InscripcionService --> Autorizador
InscripcionService --> ValidadorCorrelativas
InscripcionService --> InscripcionRepository
AsistenciaService --> Autorizador
AsistenciaService --> CalculadoraRegularidad
AsistenciaService --> AsistenciaRepository
AsistenciaService --> AuditoriaService
CalificacionService --> CalculadoraCondicion
CalificacionService --> CalificacionRepository
CalificacionService --> AuditoriaService
ActaService --> ActaRepository
ActaService --> AuditoriaService
AlumnoService --> AlumnoRepository
InscripcionRepositoryImpl ..|> InscripcionRepository
InscripcionRepositoryImpl --> ConfiguracionBaseDatos
@enduml

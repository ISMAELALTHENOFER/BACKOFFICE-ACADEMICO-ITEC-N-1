@startuml paquetes
!pragma layout smetana
skinparam shadowing false
title Paquetes del sistema (itec.backoffice)

package "itec.backoffice" {
  folder "view" as vista
  folder "controller" as ctrl
  folder "dto" as dto
  folder "service" as srv
  folder "service.impl" as impl
  folder "rule" as rule
  folder "report" as rep
  folder "security" as sec
  folder "model" as model
  folder "exception" as exc
  folder "repository" as repo
  folder "configuration" as cfg
}

vista ..> ctrl
ctrl ..> srv
ctrl ..> dto
ctrl ..> sec
impl ..|> srv
impl ..> rule
impl ..> rep
rep ..> model
impl ..> repo
impl ..> model
impl ..> exc
impl ..> sec
srv ..> dto
rule ..> model
repo ..> model
repo ..> cfg
@enduml

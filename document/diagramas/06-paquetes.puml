@startuml paquetes
!pragma layout smetana
skinparam shadowing false
title Paquetes del sistema (itec.backoffice)

package "itec.backoffice" {
  folder "app" as app
  folder "presentation.view" as vista
  folder "presentation.controller" as ctrl
  folder "service" as srv
  folder "security" as sec
  folder "domain.model" as model
  folder "domain.rule" as rule
  folder "domain.exception" as exc
  folder "repository" as repo
  folder "persistence" as pers
  folder "config" as cfg
}

app ..> ctrl
app ..> cfg
vista ..> ctrl
ctrl ..> srv
ctrl ..> sec
ctrl ..> model
srv ..> sec
srv ..> rule
srv ..> model
srv ..> exc
srv ..> repo
rule ..> model
repo ..> model
pers ..> repo
pers ..> model
pers ..> cfg
@enduml

@startuml dss-crear-alumno
skinparam shadowing false
title DSS - UC-03 Gestionar alumnos (Crear)
actor "Administrativo" as U
participant ":Sistema" as S
U -> S : crearAlumno(dni, nombre, apellido, email, teléfono)
alt datos válidos y DNI no registrado
  S --> U : alumno creado en estado ACTIVO
else DNI duplicado
  S --> U : "Ya existe un alumno con ese DNI"
else datos inválidos
  S --> U : detalle de campos inválidos
end
@enduml

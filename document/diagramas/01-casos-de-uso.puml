@startuml casos-de-uso
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Administrativo\n(ADM)" as ADM
actor "Docente\n(DOC)" as DOC
actor "Alumno\n(ALU)" as ALU

rectangle "Backoffice Académico ITEC N°1" {
  usecase "UC-01 Iniciar sesión" as UC01
  usecase "UC-02 Gestionar usuarios" as UC02
  usecase "UC-03 Gestionar alumnos" as UC03
  usecase "UC-04 Gestionar docentes" as UC04
  usecase "UC-05 Gestionar materias\ny correlativas" as UC05
  usecase "UC-06 Gestionar oferta académica\n(comisiones, horarios, clases)" as UC06
  usecase "UC-07 Asignar docente a comisión" as UC07
  usecase "UC-08 Inscribir alumno a cursada" as UC08
  usecase "UC-09 Registrar asistencia" as UC09
  usecase "UC-10 Justificar inasistencia" as UC10
  usecase "UC-11 Cerrar asistencia de comisión" as UC11
  usecase "UC-12 Registrar calificación\nde cursada" as UC12
  usecase "UC-13 Registrar nota final" as UC13
  usecase "UC-14 Modificar calificación" as UC14
  usecase "UC-15 Cerrar acta final" as UC15
  usecase "UC-16 Reabrir acta o asistencia" as UC16
  usecase "UC-17 Generar reportes académicos" as UC17
  usecase "UC-18 Consultar situación académica" as UC18
  usecase "Validar correlativas" as VC
  usecase "Calcular regularidad" as CR
  usecase "Registrar auditoría" as AUD
}

ADM --> UC01
DOC --> UC01
ALU --> UC01

ADM --> UC02
ADM --> UC03
ADM --> UC04
ADM --> UC05
ADM --> UC06
ADM --> UC07
ADM --> UC08
ADM --> UC10
ADM --> UC16
ADM --> UC17

DOC --> UC09
DOC --> UC10
DOC --> UC11
DOC --> UC12
DOC --> UC13
DOC --> UC14
DOC --> UC15
DOC --> UC17

ALU --> UC18

UC08 ..> VC : <<include>>
UC13 ..> VC : <<include>>
UC09 ..> CR : <<include>>
UC10 ..> CR : <<include>>
UC11 ..> CR : <<include>>
UC09 ..> AUD : <<include>>
UC14 ..> AUD : <<include>>
UC16 ..> AUD : <<include>>
@enduml

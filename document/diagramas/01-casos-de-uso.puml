@startuml casos-de-uso
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Administrador\n(ADMIN)" as ADMIN
actor "Administrativo\n(ADMINISTRATIVO)" as ADM
actor "Profesor\n(PROFESOR)" as PROF
actor "Alumno\n(ALUMNO)" as ALU

ADMIN -|> ADM

rectangle "Backoffice Académico ITEC N°1" {
  usecase "UC-01 Iniciar sesión" as UC01
  usecase "UC-02 Gestionar usuarios" as UC02
  usecase "UC-03 Gestionar alumnos\ne inscripción a carrera" as UC03
  usecase "UC-04 Gestionar profesores" as UC04
  usecase "UC-05 Gestionar materias\ny correlativas" as UC05
  usecase "UC-06 Gestionar oferta académica\n(carreras, planes, cuatrimestres,\ncomisiones, horarios)" as UC06
  usecase "UC-07 Asignar profesor a comisión" as UC07
  usecase "UC-08 Inscribir alumno a comisión" as UC08
  usecase "UC-09 Registrar asistencia" as UC09
  usecase "UC-10 Justificar inasistencia" as UC10
  usecase "UC-11 Cerrar asistencia de comisión" as UC11
  usecase "UC-12 Registrar nota de cursada" as UC12
  usecase "UC-13 Registrar nota final" as UC13
  usecase "UC-14 Modificar nota" as UC14
  usecase "UC-15 Cerrar acta final" as UC15
  usecase "UC-16 Reabrir acta o asistencia" as UC16
  usecase "UC-17 Generar reportes académicos" as UC17
  usecase "UC-18 Consultar situación académica" as UC18
  usecase "Validar correlativas" as VC
  usecase "Calcular regularidad" as CR
  usecase "Registrar auditoría" as AUD
}

ADM --> UC01
PROF --> UC01
ALU --> UC01

ADM --> UC02
ADM --> UC03
ADM --> UC04
ADM --> UC05
ADM --> UC06
ADM --> UC07
ADM --> UC08
ADM --> UC10
ADM --> UC16
ADM --> UC17

PROF --> UC09
PROF --> UC10
PROF --> UC11
PROF --> UC12
PROF --> UC13
PROF --> UC14
PROF --> UC15
PROF --> UC17

ALU --> UC18

UC08 ..> VC : <<include>>
UC13 ..> VC : <<include>>
UC09 ..> CR : <<include>>
UC10 ..> CR : <<include>>
UC11 ..> CR : <<include>>
UC09 ..> AUD : <<include>>
UC14 ..> AUD : <<include>>
UC16 ..> AUD : <<include>>

note bottom of ADMIN
  Hereda todos los casos de uso
  del Administrativo. Solo el ADMIN
  crea usuarios ADMIN y ADMINISTRATIVO.
end note
@enduml

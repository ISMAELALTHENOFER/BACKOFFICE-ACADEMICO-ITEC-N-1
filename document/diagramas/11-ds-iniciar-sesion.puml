@startuml ds-iniciar-sesion
skinparam shadowing false
title DS - iniciarSesion(username, contraseña)
actor Usuario
participant ":AuthController" as C
participant ":AuthServiceImpl" as A
participant ":UserRepository" as R
participant ":PasswordEncoder" as H
participant ":Sesion" as SE

Usuario -> C : login()
C -> A : login(username, clave)
A -> R : findByUsername(username)
R --> A : Optional<User>
alt usuario existe
  A -> H : matches(clave, user.password)
  H --> A : boolean
end
alt usuario inexistente o contraseña incorrecta
  A --> C : CredencialesInvalidasException
  C --> Usuario : "Usuario o contraseña incorrectos"
else usuario inactivo
  A --> C : AccesoDenegadoException
  C --> Usuario : "Usuario inactivo o sin permisos"
else verificación correcta
  A -> SE : iniciar(user)
  A --> C : user
  C -> C : abrirMenu(user.roles)
  C --> Usuario : menú según roles
end
@enduml

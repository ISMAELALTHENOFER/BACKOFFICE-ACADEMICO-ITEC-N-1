@startuml ds-cerrar-acta
skinparam shadowing false
title DS - cerrarActa(actaId)
actor Docente
participant ":ActaController" as C
participant ":ActaService" as S
participant ":Autorizador" as AU
participant ":ActaRepository" as AC
participant ":InscripcionRepository" as IR
participant ":CalificacionRepository" as CR
participant ":CalculadoraCondicion" as CC
participant ":AuditoriaService" as AUD

Docente -> C : cerrarActa()
C -> S : cerrar(actaId)
S -> AC : buscarPorId(actaId)
AC --> S : acta
S -> AU : exigirDocenteAsignado(comisionId)
S -> IR : listarRegularesPorComision(comisionId)
IR --> S : inscripciones
S -> CR : listarPorEvaluacion(evaluacionFinalId)
CR --> S : notas finales
alt todas las inscripciones tienen nota
  group transacción
    loop por cada inscripción
      S -> CC : resultadoFinal(nota)
      CC --> S : APROBADO | DESAPROBADO
      S -> IR : actualizarEstado(inscripcionId, estado)
    end
    S -> AC : marcarCerrada(actaId, usuario, fecha)
    S -> AUD : registrar("CIERRE_ACTA", "acta_final", actaId, "ABIERTA", "CERRADA", null)
  end
  S --> C : ok
  C --> Docente : acta cerrada
else faltan notas
  S --> C : ReglaNegocioException(alumnos sin nota)
  C --> Docente : lista de pendientes
end
@enduml
